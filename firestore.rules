rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    // Personal data (regular expenses, budgets, settings) — owner only.
    match /users/{userId}/{document=**} {
      allow read, write: if isAuth() && request.auth.uid == userId;
    }

    // ── Travel group document ─────────────────────────────────────────────────

    match /users/{ownerId}/travelGroups/{groupId} {
      // Read: owner or any listed member
      allow read: if isAuth() &&
        (request.auth.uid == ownerId ||
         request.auth.uid in resource.data.memberIds);

      // Full write: owner
      allow write: if isAuth() && request.auth.uid == ownerId;

      // Self-join: allow updating memberIds/updatedAt to add oneself
      allow update: if isAuth() &&
        request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['memberIds', 'updatedAt']) &&
        request.auth.uid in request.resource.data.memberIds;
    }

    // Helper: caller is an existing member of the travel group.
    function isMember(ownerId, groupId) {
      return request.auth.uid in
        get(/databases/$(database)/documents/users/$(ownerId)/travelGroups/$(groupId))
          .data.memberIds;
    }

    // ── Trip sub-collections (members, expenses) ──────────────────────────────

    match /users/{ownerId}/travelGroups/{groupId}/members/{docId} {
      // Read: owner or existing group member only.
      // Note: the duplicate-member check in joinByCode is wrapped in try/catch,
      // so a permission denial for non-members is handled gracefully.
      allow read: if isAuth() &&
        (request.auth.uid == ownerId || isMember(ownerId, groupId));

      // Write: owner, existing member, or self-registration
      allow write: if isAuth() &&
        (request.auth.uid == ownerId ||
         isMember(ownerId, groupId) ||
         request.resource.data.userId == request.auth.uid);
    }

    match /users/{ownerId}/travelGroups/{groupId}/expenses/{docId} {
      allow read: if isAuth() &&
        (request.auth.uid == ownerId || isMember(ownerId, groupId));
      allow write: if isAuth() &&
        (request.auth.uid == ownerId || isMember(ownerId, groupId));
    }

    // ── Invite codes ──────────────────────────────────────────────────────────
    // Read stays open to any authenticated user: the joiner only has the code
    // string and must look it up to discover the group — this is intentional.
    // Write is gated to the code creator (ownerId field).

    match /travelInviteCodes/{code} {
      allow read: if isAuth();
      allow create: if isAuth() &&
        request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAuth() &&
        resource.data.ownerId == request.auth.uid;
    }

    // ── Email invites ─────────────────────────────────────────────────────────
    // Owner creates and may delete. Invitee reads (queried by email) and
    // deletes their own invite after joining.

    match /travelEmailInvites/{docId} {
      allow read: if isAuth() &&
        (request.auth.uid == resource.data.ownerId ||
         request.auth.token.email == resource.data.email);
      allow create: if isAuth() &&
        request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuth() &&
        request.auth.uid == resource.data.ownerId;
      allow delete: if isAuth() &&
        (request.auth.uid == resource.data.ownerId ||
         request.auth.token.email == resource.data.email);
    }

    // ── Expense Groups ────────────────────────────────────────────────────────

    match /groups/{groupId} {
      // Any authenticated member can read the group document.
      allow read: if isAuth() &&
        request.auth.uid in resource.data.memberUids;

      // Only the creator can create the group.
      allow create: if isAuth() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.auth.uid in request.resource.data.memberUids;

      // Members can update (e.g. adding new members, changing name).
      // A new joiner is not yet in memberUids, so also allow self-join updates
      // that only affect members/memberUids/updatedAt.
      allow update: if isAuth() && (
        request.auth.uid in resource.data.memberUids ||
        (request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['members', 'memberUids', 'updatedAt']) &&
         request.auth.uid in request.resource.data.memberUids)
      );

      // Creator can always delete; last remaining member can also delete
      // so they aren't stuck with an orphaned group if the creator left first.
      allow delete: if isAuth() && (
        resource.data.createdBy == request.auth.uid ||
        (resource.data.memberUids.size() == 1 &&
         request.auth.uid in resource.data.memberUids)
      );

      match /expenses/{expenseId} {
        allow read, write: if isAuth() &&
          request.auth.uid in
            get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids;
      }
    }

    // ── Group invite codes (hashed) ───────────────────────────────────────────

    match /groupInvites/{hashedCode} {
      // Any authenticated user can read (to validate the code).
      allow read: if isAuth();
      // Only creator can create.
      allow create: if isAuth() &&
        request.resource.data.createdBy == request.auth.uid;
      // Allow marking used by any authenticated user (the joiner).
      allow update: if isAuth() &&
        request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['used']);
      allow delete: if isAuth() &&
        resource.data.createdBy == request.auth.uid;
    }

  }
}
